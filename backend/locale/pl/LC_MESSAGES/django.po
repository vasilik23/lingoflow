msgid "Zwrot „porównać wyniki” oznacza „сравнить результаты”, czyli wskazać podobieństwa i różnice rezultatów."
msgstr "Zwrot „porównać wyniki” oznacza wskazać podobieństwa i różnice rezultatów."

msgid "Zwrot „wyciągnąć wniosek” znaczy „сделать вывод”, czyli sformułować rezultat na podstawie danych."
msgstr "Zwrot „wyciągnąć wniosek” znaczy sformułować rezultat na podstawie danych."

msgid "„Cytować” odpowiada rosyjskiemu „цитировать” i oznacza dosłownie przytaczać cudze słowa ze źródłem."
msgstr "„Cytować” oznacza dosłownie przytaczać cudze słowa ze wskazaniem źródła."

msgid "„Dowód” to po rosyjsku „доказательство”, czyli fakt lub argument potwierdzający dane twierdzenie."
msgstr "„Dowód” to fakt lub argument potwierdzający dane twierdzenie."

msgid "„Etap pośredni” to „промежуточный этап”, znajdujący się między rozpoczęciem a zakończeniem projektu."
msgstr "„Etap pośredni” znajduje się między rozpoczęciem a zakończeniem projektu."

msgid "„Harmonogram” oznacza „график”, czyli uporządkowany w czasie plan działań i terminów projektu."
msgstr "„Harmonogram” to uporządkowany w czasie plan działań i terminów projektu."

msgid "„Kontrargument” to „контраргумент”, a więc argument skierowany przeciwko wcześniej przedstawionej tezie."
msgstr "„Kontrargument” to argument skierowany przeciwko wcześniej przedstawionej tezie."

msgid "„Kryterium sukcesu” to „критерий успеха”, pozwalający zmierzyć, czy projekt osiągnął cel."
msgstr "„Kryterium sukcesu” pozwala zmierzyć, czy projekt osiągnął cel."

msgid "„Ocenić rezultat” oznacza „оценить результат”, czyli porównać uzyskany wynik z przyjętymi kryteriami."
msgstr "„Ocenić rezultat” oznacza porównać uzyskany wynik z przyjętymi kryteriami."

msgid "„Porządek obrad” oznacza rosyjską „повестку встречи”, czyli listę kwestii zaplanowanych do omówienia."
msgstr "„Porządek obrad” to lista kwestii zaplanowanych do omówienia."

msgid "„Przypis” oznacza rosyjską „сноску”, która wskazuje źródło informacji lub dodaje objaśnienie."
msgstr "„Przypis” wskazuje źródło informacji lub dodaje objaśnienie."

msgid "„Pytanie badawcze” oznacza „исследовательский вопрос” i precyzyjnie określa problem analizowany w projekcie."
msgstr "„Pytanie badawcze” precyzyjnie określa problem analizowany w projekcie."

msgid "„Sparafrazować” znaczy „перефразировать”, a więc przekazać tę samą myśl własnymi słowami."
msgstr "„Sparafrazować” znaczy przekazać tę samą myśl własnymi słowami."

msgid "„Streszczenie” to rosyjskie „резюме”, czyli zwięzłe przedstawienie najważniejszych treści dłuższego tekstu."
msgstr "„Streszczenie” to zwięzłe przedstawienie najważniejszych treści dłuższego tekstu."

msgid "„Teza” odpowiada rosyjskiemu słowu „тезис” i nazywa główne twierdzenie wymagające uzasadnienia."
msgstr "„Teza” to główne twierdzenie wymagające uzasadnienia."

msgid "„Uzasadnienie” oznacza „обоснование”, czyli przedstawienie powodów i dowodów wspierających daną decyzję."
msgstr "„Uzasadnienie” to przedstawienie powodów i dowodów wspierających daną decyzję."

msgid "„Wiarygodne źródło” to po rosyjsku „надёжный источник”, czyli materiał zasługujący na zaufanie."
msgstr "„Wiarygodne źródło” to materiał zasługujący na zaufanie."

msgid "„Wniosek” oznacza rosyjski „вывод”, formułowany na podstawie wcześniej przedstawionych danych i argumentów."
msgstr "„Wniosek” formułuje się na podstawie wcześniej przedstawionych danych i argumentów."

msgid "„Zakres badania” to „охват исследования”, określający temat, granice i obszar przeprowadzonej analizy."
msgstr "„Zakres badania” określa temat, granice i obszar przeprowadzonej analizy."

msgid "„Zastrzeżenie” odpowiada rosyjskiej „оговорке” i wskazuje ograniczenie albo warunek przedstawionej opinii."
msgstr "„Zastrzeżenie” wskazuje ograniczenie albo warunek przedstawionej opinii."

msgid "„Założenie” odpowiada rosyjskiej „предпосылке”, czyli twierdzeniu przyjętemu jako punkt wyjścia analizy."
msgstr "„Założenie” to twierdzenie przyjęte jako punkt wyjścia analizy."

msgid "Brzmieć protekcjonalnie — звучать покровительственно, словно говорящий считает себя компетентнее или выше адресата."
msgstr "Brzmieć protekcjonalnie oznacza mówić z wyższością, jakby mówiący uważał się za bardziej kompetentnego lub ważniejszego od adresata."

msgid "Dobór słów означает осознанный выбор лексики: одна и та же мысль может звучать нейтрально, официально или разговорно."
msgstr "Dobór słów oznacza świadome wybieranie słownictwa: ta sama myśl może brzmieć neutralnie, oficjalnie lub potocznie."

msgid "Dobór słów — выбор слов; выражение подчёркивает, что автор сознательно подбирает лексику под цель и адресата."
msgstr "Dobór słów podkreśla, że autor świadomie wybiera słownictwo zgodnie z celem i adresatem."

msgid "Dostosować wypowiedź — адаптировать высказывание, то есть изменить лексику, тон или структуру под конкретного адресата."
msgstr "Dostosować wypowiedź oznacza zmienić słownictwo, ton lub strukturę z myślą o konkretnym adresacie."

msgid "Neutralny значит нейтральный: без заметной разговорной окраски и без подчёркнутой официальности."
msgstr "Neutralny oznacza pozbawiony wyraźnego zabarwienia potocznego i podkreślonej oficjalności."

msgid "Neutralny — лишённый подчёркнутой фамильярности и официальности; такой тон подходит широкой аудитории и передаёт смысл без лишней оценки."
msgstr "Neutralny ton nie jest nadmiernie poufały ani oficjalny; pasuje do szerokiego grona odbiorców i przekazuje sens bez zbędnej oceny."

msgid "Oficjalny значит официальный; такой стиль соблюдает институциональные нормы и обычно сохраняет дистанцию."
msgstr "Oficjalny styl przestrzega norm instytucjonalnych i zwykle zachowuje dystans."

msgid "Oficjalny называют регистр с установленными формулами, точными формулировками и большей дистанцией между автором и адресатом."
msgstr "Oficjalny rejestr wykorzystuje ustalone formuły, precyzyjne sformułowania i większy dystans między autorem a adresatem."

msgid "Potoczny значит разговорный: естественный для неофициальной устной речи и близких отношений."
msgstr "Potoczny oznacza naturalny dla nieoficjalnej mowy i bliskich relacji."

msgid "Potoczny описывает непринуждённую разговорную речь; такие формы уместны среди знакомых, но не всегда подходят официальному письму."
msgstr "Potoczny opisuje swobodną mowę; takie formy są odpowiednie wśród znajomych, ale nie zawsze pasują do oficjalnego pisma."

msgid "Rejestr — это регистр речи: набор языковых средств, соответствующий конкретной ситуации общения."
msgstr "Rejestr to zestaw środków językowych odpowiadający konkretnej sytuacji komunikacyjnej."

msgid "Skrócić dystans — сократить дистанцию, сделав общение менее формальным и более непосредственным."
msgstr "Skrócić dystans oznacza uczynić komunikację mniej formalną i bardziej bezpośrednią."

msgid "Wybierz wyrażenie pasujące do celu: выбор слов."
msgstr "Wybierz wyrażenie pasujące do celu: świadome wybieranie słownictwa."

msgid "Wybierz wyrażenie pasujące do celu: нейтральный."
msgstr "Wybierz wyrażenie pasujące do celu: bez wyraźnej potoczności ani oficjalności."

msgid "Wybierz wyrażenie pasujące do celu: официальный."
msgstr "Wybierz wyrażenie pasujące do celu: zgodny z normami instytucjonalnymi."

msgid "Wybierz wyrażenie pasujące do celu: разговорный."
msgstr "Wybierz wyrażenie pasujące do celu: charakterystyczny dla swobodnej rozmowy."

msgid "Wybierz wyrażenie pasujące do celu: регистр."
msgstr "Wybierz wyrażenie pasujące do celu: odmiana języka dostosowana do sytuacji."

msgid "Wybierz wyrażenie pasujące do celu: формула вежливости."
msgstr "Wybierz wyrażenie pasujące do celu: ustalona uprzejma formuła."

msgid "Zachować dystans — сохранять дистанцию: поддерживать уважительный, не слишком личный характер общения."
msgstr "Zachować dystans oznacza utrzymać pełen szacunku, niezbyt osobisty charakter komunikacji."

msgid "Zwrot grzecznościowy — устойчивая формула вежливости, например Szanowna Pani или Z poważaniem, а не просто нейтральное слово."
msgstr "Zwrot grzecznościowy to ustalona uprzejma formuła, na przykład Szanowna Pani lub Z poważaniem, a nie tylko neutralne słowo."

msgid "Zwrot grzecznościowy — формула вежливости, которая обозначает уважение и регулирует дистанцию между собеседниками."
msgstr "Zwrot grzecznościowy wyraża szacunek i reguluje dystans między rozmówcami."

msgid "В первом абзаце названы три разных адресата — друг, команда и учреждение, поэтому для каждого понадобился свой тон."
msgstr "W pierwszym akapicie wskazano trzech adresatów: przyjaciela, zespół i instytucję; każdy wymagał innego tonu."

msgid "В четвёртом абзаце редактор замечает риск чрезмерной вежливости: она способна прозвучать покровительственно."
msgstr "W czwartym akapicie redaktor dostrzega ryzyko nadmiernej uprzejmości: może ona brzmieć protekcjonalnie."

msgid "Второй абзац описывает разговорную версию: она короткая и прямая, но в обращении к учреждению была бы неуместна."
msgstr "Drugi akapit opisuje wersję potoczną: krótką i bezpośrednią, ale nieodpowiednią w piśmie do instytucji."

msgid "Выбирай формулировку с учётом смысла, адресата и контекста."
msgstr "Wybieraj sformułowanie z uwzględnieniem sensu, adresata i kontekstu."

msgid "Первый абзац вводит исходную ситуацию целиком: редактор готовит три версии одного сообщения для трёх адресатов."
msgstr "Pierwszy akapit przedstawia całą sytuację wyjściową: redaktor przygotowuje trzy wersje jednej wiadomości dla trzech adresatów."

msgid "Последний абзац формулирует общий вывод: хороший регистр определяется точным соответствием адресату, а не сложностью слов."
msgstr "Ostatni akapit formułuje ogólny wniosek: dobry rejestr zależy od trafnego dopasowania do adresata, a nie od trudności słów."

msgid "Регистр — это разновидность речи, которую выбирают с учётом ситуации, цели и отношений между собеседниками."
msgstr "Rejestr to odmiana wypowiedzi wybierana z uwzględnieniem sytuacji, celu i relacji między rozmówcami."

msgid "Третий абзац посвящён официальной версии: в ней есть формула вежливости и точная цель, однако тон не становится холодным."
msgstr "Trzeci akapit dotyczy wersji oficjalnej: zawiera zwrot grzecznościowy i precyzyjny cel, ale ton nie staje się chłodny."

