msgstr "„kontrargument” to argument przeciw danej tezie."

msgid "„kryterium sukcesu” — критерий успеха."
msgstr "„kryterium sukcesu” to warunek oceny powodzenia."

msgid "„ocenić rezultat” — оценить результат."
msgstr "„ocenić rezultat” oznacza sprawdzić jakość wyniku."

msgid "„pytanie badawcze” — исследовательский вопрос."
msgstr "„pytanie badawcze” określa, czego chcemy się dowiedzieć."

msgid "„uzasadnienie” — обоснование."
msgstr "„uzasadnienie” wyjaśnia podstawy stanowiska."

msgid "„wyciągnąć wniosek” — сделать вывод."
msgstr "„wyciągnąć wniosek” oznacza sformułować rezultat rozumowania."

msgid "„zastrzeżenie” — оговорка."
msgstr "„zastrzeżenie” to wskazanie wątpliwości lub ograniczenia."

msgid "„założenie” — предпосылка."
msgstr "„założenie” to przyjęta przesłanka."

msgid "Итоговый B2-проект: данные, защита решения и честная самооценка"
msgstr "Projekt końcowy B2: dane, obrona rozwiązania i uczciwa samoocena"

msgid "Как жительница проверила срок, основание и структуру официального обращения"
msgstr "Jak mieszkanka sprawdziła termin, podstawę i strukturę oficjalnego pisma"

msgid "Как команда превратила сложное обсуждение в ясный план"
msgstr "Jak zespół zmienił złożoną dyskusję w jasny plan"

msgid "Как международная команда разобрала недоразумение без стереотипов"
msgstr "Jak międzynarodowy zespół wyjaśnił nieporozumienie bez stereotypów"

msgid "Как объяснить принцип системы и не скрыть ограничения исследования"
msgstr "Jak wyjaśnić zasadę działania systemu i nie ukryć ograniczeń badania"

msgid "Как оговорки и контраргументы улучшают городскую рекомендацию"
msgstr "Jak zastrzeżenia i kontrargumenty poprawiają rekomendację dla miasta"

msgid "Как отличить наблюдение от догадки о мотивах и восстановить диалог"
msgstr "Jak odróżnić obserwację od przypuszczeń o motywach i przywrócić dialog"

msgid "Как сравнение сообщений отделяет подтверждённые факты от предположений"
msgstr "Jak porównanie wiadomości oddziela potwierdzone fakty od przypuszczeń"

msgid "Как студентка сопоставила исследования и не преувеличила результат"
msgstr "Jak studentka porównała badania i nie wyolbrzymiła wyniku"

msgid "Как числа, скрытые расходы и степень уверенности меняют потребительский выбор"
msgstr "Jak liczby, ukryte koszty i stopień pewności zmieniają wybór konsumenta"

msgid "Оригинальная запись общественного обсуждения с модерацией и итогом"
msgstr "Oryginalny zapis dyskusji publicznej z moderacją i podsumowaniem"

