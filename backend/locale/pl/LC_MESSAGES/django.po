msgid "Dawkowanie — количество и частота приёма лекарства."
msgstr "Dawkowanie określa ilość i częstotliwość przyjmowania leku."

msgid "Dziecko — средний род: powinno."
msgstr "Dziecko to rodzaj nijaki: powinno."

msgid "Mam uczulenie na… — стандартная фраза об аллергии."
msgstr "Mam uczulenie na… to standardowe zdanie informujące o alergii."

msgid "Nie wolno + инфинитив: nie wolno przekraczać dawki."
msgstr "Nie wolno + bezokolicznik: nie wolno przekraczać dawki."

msgid "Pogorszyć się — ухудшиться; jeśli вводит реальное условие."
msgstr "Pogorszyć się oznacza zmianę na gorsze; jeśli wprowadza realny warunek."

msgid "Powinien/powinna/powinno согласуется с человеком; официальное należy остаётся безличным."
msgstr "Powinien/powinna/powinno zgadza się z rodzajem osoby; oficjalne należy pozostaje bezosobowe."

msgid "Trzeba + инфинитив: trzeba odpoczywać."
msgstr "Trzeba + bezokolicznik: trzeba odpoczywać."

msgid "Warto + инфинитив даёт мягкую рекомендацию."
msgstr "Warto + bezokolicznik wyraża łagodną rekomendację."

msgid "Безличная инструкция: należy przyjmować."
msgstr "Bezosobowa instrukcja: należy przyjmować."

msgid "Безличное trzeba + инфинитив выражает общую необходимость."
msgstr "Bezosobowe trzeba + bezokolicznik wyraża ogólną konieczność."

msgid "В инструкции нейтральная рекомендация: należy + инфинитив."
msgstr "W instrukcji neutralne zalecenie: należy + bezokolicznik."

msgid "Врач счёл инфекцию вирусной, поэтому антибиотик не требовался."
msgstr "Lekarz uznał infekcję za wirusową, dlatego antybiotyk nie był potrzebny."

msgid "Для женщины: powinna + инфинитив."
msgstr "Dla kobiety: powinna + bezokolicznik."

msgid "Если состояние ухудшится…"
msgstr "Jeśli stan się pogorszy…"

msgid "Запрет"
msgstr "Zakaz"

msgid "Запрет выражает безличное nie wolno + инфинитив."
msgstr "Zakaz wyraża bezosobowe nie wolno + bezokolicznik."

msgid "Здесь нельзя курить."
msgstr "Tutaj nie wolno palić."

msgid "Как сообщить об аллергии?"
msgstr "Jak poinformować o alergii?"

msgid "Кашель и слабость продолжались три дня."
msgstr "Kaszel i osłabienie trwały trzy dni."

msgid "Общая необходимость"
msgstr "Ogólna konieczność"

msgid "Повторная консультация нужна при ухудшении или сохраняющейся температуре."
msgstr "Ponowna konsultacja jest potrzebna przy pogorszeniu stanu lub utrzymującej się gorączce."

msgid "После nie wolno нужен инфинитив: odstawiać."
msgstr "Po nie wolno potrzebny jest bezokolicznik: odstawiać."

msgid "Рекомендации: отдых, жидкость и средство от температуры."
msgstr "Zalecenia: odpoczynek, płyny i lek przeciwgorączkowy."

msgid "Рекомендация"
msgstr "Zalecenie"

msgid "Сонливость может быть побочным эффектом лекарства."
msgstr "Senność może być skutkiem ubocznym leku."

msgid "Фармацевт уточнила аллергию и другие лекарства."
msgstr "Farmaceutka zapytała o alergie i inne leki."

msgid "Форма powinien согласуется с pan в мужском роде."
msgstr "Forma powinien zgadza się z pan w rodzaju męskim."

msgid "Что может вызвать сонливость?"
msgstr "Co może powodować senność?"

msgid "Что означает dawkowanie?"
msgstr "Co oznacza dawkowanie?"

