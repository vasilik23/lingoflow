msgstr "pociąg"

msgid "поездка; отъезд"
msgstr "wyjazd"

msgid "путешествие"
msgstr "podróż"

msgid "самолёт"
msgstr "samolot"

msgid "собирать вещи"
msgstr "pakować się"

msgid "существительное в творительном падеже"
msgstr "rzeczownik w narzędniku"

msgid "только прошедшее время"
msgstr "tylko czas przeszły"

msgid "чемодан"
msgstr "walizka"

msgid "Kaucja — залог, который обычно возвращают после окончания аренды."
msgstr "Kaucja to kwota zabezpieczająca, zwykle zwracana po zakończeniu najmu."

msgid "Potrzebować требует родительного падежа: potrzebujemy hydraulika."
msgstr "Potrzebować wymaga dopełniacza: potrzebujemy hydraulika."

msgid "Szukać и potrzebować требуют родительного: szukam mieszkania, potrzebuję hydraulika."
msgstr "Szukać i potrzebować wymagają dopełniacza: szukam mieszkania, potrzebuję hydraulika."

msgid "Szukać управляет родительным падежом: nowego mieszkania."
msgstr "Szukać łączy się z dopełniaczem: nowego mieszkania."

msgid "Ustalić termin naprawy — назначить время ремонта."
msgstr "Ustalić termin naprawy oznacza uzgodnić, kiedy odbędzie się naprawa."

msgid "Zgłosić usterkę administracji — сообщить управляющей компании о неисправности."
msgstr "Zgłosić usterkę administracji oznacza poinformować administrację o problemie."

msgid "Администрация назначила визит на вторник с 16 до 18."
msgstr "Administracja umówiła wizytę na wtorek od 16 do 18."

msgid "Глагол szukać требует родительного падежа: szukamy mieszkania."
msgstr "Czasownik szukać wymaga dopełniacza: szukamy mieszkania."

msgid "Глагольное управление"
msgstr "Rekcja czasownika"

msgid "Ему нужны были описание проблемы и фотография счётчика."
msgstr "Potrzebował opisu problemu i zdjęcia licznika."

msgid "Если специалист не придёт вовремя, она снова свяжется с администрацией."
msgstr "Jeśli specjalista nie przyjdzie na czas, ponownie skontaktuje się z administracją."

msgid "Когда z означает «с»: problem z ogrzewaniem, rozmowa z właścicielem."
msgstr "Gdy z oznacza wspólność: problem z ogrzewaniem, rozmowa z właścicielem."

msgid "Куда сообщить о неисправности?"
msgstr "Gdzie zgłosić usterkę?"

msgid "Лицо после z ставится в творительном падеже: z hydraulikiem."
msgstr "Osoba po z występuje w narzędniku: z hydraulikiem."

msgid "Отрицательная конструкция nie ma требует родительного: prądu."
msgstr "Przeczenie nie ma wymaga dopełniacza: prądu."

msgid "После nie ma употребляется родительный падеж: ciepłej wody."
msgstr "Po nie ma używamy dopełniacza: ciepłej wody."

msgid "После nie ma: nie ma prądu, ciepłej wody, ogrzewania."
msgstr "Po nie ma: nie ma prądu, ciepłej wody, ogrzewania."

msgid "После z в значении «с чем?» нужен творительный падеж: z ogrzewaniem."
msgstr "Po z w pytaniu z czym? potrzebny jest narzędnik: z ogrzewaniem."

msgid "После z в значении совместности употребляется творительный: z właścicielem."
msgstr "Po z oznaczającym wspólność używamy narzędnika: z właścicielem."

msgid "После z в конструкции problem z нужен творительный: kranem."
msgstr "Po z w konstrukcji problem z potrzebny jest narzędnik: kranem."

msgid "При аренде стороны подписывают umowę — договор."
msgstr "Przy najmie strony podpisują umowę."

msgid "Разговариваю с владельцем."
msgstr "Rozmawiam z właścicielem."

msgid "Родительный после отрицания"
msgstr "Dopełniacz po przeczeniu"

msgid "Сначала она позвонила владельцу квартиры."
msgstr "Najpierw zadzwoniła do właściciela mieszkania."

msgid "Творительный после z"
msgstr "Narzędnik po z"

msgid "Утром Лена заметила, что отопление не работает."
msgstr "Rano Lena zauważyła, że ogrzewanie nie działa."

msgid "Что обычно подписывают при аренде?"
msgstr "Co zwykle podpisujemy przy najmie?"

msgid "Что означает kaucja?"
msgstr "Co oznacza kaucja?"

msgid "арендная плата"
msgstr "czynsz"

msgid "владелец"
msgstr "właściciel"

msgid "горячая вода"
msgstr "ciepła woda"

msgid "договор"
msgstr "umowa"

msgid "залог"
msgstr "kaucja"

msgid "неисправность"
msgstr "usterka"

msgid "отопление"
msgstr "ogrzewanie"

msgid "ремонт; починка"
msgstr "naprawa"

msgid "сантехник"
msgstr "hydraulik"

msgid "снимать; сдавать"
msgstr "wynajmować"

msgid "сообщать; заявлять"
msgstr "zgłaszać"

msgid "срок; назначенное время"
msgstr "termin"

msgid "счётчик"
msgstr "licznik"

msgid "управляющая компания"
msgstr "administracja budynku"

msgid "электричество"
msgstr "prąd"

msgid "Codziennie и przez godzinę указывают на процесс; do piątku и najpierw… potem часто требуют результата."
msgstr "Codziennie i przez godzinę wskazują proces; do piątku oraz najpierw… potem często wskazują oczekiwany rezultat."

msgid "Mam doświadczenie w sprzedaży — естественная конструкция об опыте."
msgstr "Mam doświadczenie w sprzedaży to naturalna konstrukcja opisująca doświadczenie."

msgid "Obowiązek — обязанность или служебная задача."
msgstr "Obowiązek to powinność lub zadanie służbowe."

msgid "Teraz указывает на текущий процесс: rozwiązuję."
msgstr "Teraz wskazuje bieżący proces: rozwiązuję."

msgid "Termin — назначенная дата или крайний срок."
msgstr "Termin to ustalona data lub ostateczny czas wykonania zadania."

msgid "Важен завершённый результат к сроку: przygotować."
msgstr "Ważny jest zakończony rezultat przed terminem: przygotować."

msgid "Длительность процесса в прошлом передаёт несовершенный pisać: pisałam."
msgstr "Trwanie procesu w przeszłości wyraża niedokonane pisać: pisałam."

msgid "Завершённый единичный результат: rozwiązała."
msgstr "Pojedynczy zakończony rezultat: rozwiązała."

msgid "Каждое утро она проверяет почту и планирует задачи."
msgstr "Każdego ranka sprawdza pocztę i planuje zadania."

msgid "Как сказать «у меня опыт в продажах»?"
msgstr "Jak powiedzieć, że masz doświadczenie w sprzedaży?"

msgid "Коллега показал ей, как быстрее заполнить таблицу."
msgstr "Kolega pokazał jej, jak szybciej wypełnić tabelę."

msgid "Контекст помогает"
msgstr "Kontekst pomaga"

msgid "Майя начала работу в небольшой IT-компании."
msgstr "Maja rozpoczęła pracę w małej firmie IT."

msgid "Несовершенный вид"
msgstr "Aspekt niedokonany"

msgid "Однократное завершённое действие в прошлом: wyjaśnił."
msgstr "Pojedyncza zakończona czynność w przeszłości: wyjaśnił."

msgid "Однократный законченный результат: zrobić, napisać, przygotować, rozwiązać."
msgstr "Pojedynczy zakończony rezultat: zrobić, napisać, przygotować, rozwiązać."

msgid "Она закончила отчёт раньше срока и получила похвалу."
msgstr "Skończyła raport przed terminem i otrzymała pochwałę."

msgid "Она решила проблему за десять минут."
msgstr "Rozwiązała problem w dziesięć minut."

msgid "Повторяющийся процесс выражает несовершенный вид: przygotowuję."
msgstr "Powtarzający się proces wyraża aspekt niedokonany: przygotowuję."

msgid "Последовательность завершённых будущих действий требует совершенного sprawdzę."
msgstr "Kolejność zakończonych czynności przyszłych wymaga dokonanego sprawdzę."

msgid "Процесс, повторение и длительность: robić, pisać, przygotowywać, rozwiązywać."
msgstr "Proces, powtarzanie i trwanie: robić, pisać, przygotowywać, rozwiązywać."

msgid "Регулярное действие: несовершенный analizuję."
msgstr "Regularna czynność: niedokonane analizuję."

msgid "Результат к концу дня: совершенный zrobię."
msgstr "Rezultat do końca dnia: dokonane zrobię."

msgid "Руководитель поручил подготовить отчёт для клиента."
msgstr "Kierownik polecił przygotować raport dla klienta."

msgid "Следующий завершённый этап в будущем: wyślemy."
msgstr "Kolejny zakończony etap w przyszłości: wyślemy."

msgid "Совершенный вид"
msgstr "Aspekt dokonany"

