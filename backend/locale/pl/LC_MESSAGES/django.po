msgstr "aktor"

msgid "время начала"
msgstr "godzina rozpoczęcia"

msgid "выставка"
msgstr "wystawa"

msgid "герой произведения"
msgstr "bohater utworu"

msgid "оценивать"
msgstr "oceniać"

msgid "режиссёр"
msgstr "reżyser"

msgid "рекомендовать"
msgstr "polecać"

msgid "рецензия"
msgstr "recenzja"

msgid "роман"
msgstr "powieść"

msgid "сериал"
msgstr "serial"

msgid "серия"
msgstr "odcinek"

msgid "скучный"
msgstr "nudny"

msgid "спектакль"
msgstr "spektakl"

msgid "сюжет"
msgstr "fabuła"

msgid "трогательный"
msgstr "wzruszający"

msgid "трогательный финал"
msgstr "wzruszające zakończenie"

msgid "цена билета"
msgstr "cena biletu"

msgid "Brakować требует родительного: brakuje podpisu."
msgstr "Brakować wymaga dopełniacza: brakuje podpisu."

msgid "Chciałbym/chciałabym — стандартная вежливая форма просьбы."
msgstr "Chciałbym/chciałabym to standardowa uprzejma forma prośby."

msgid "Chciałbym/chciałabym… и Czy może pan/pani… смягчают официальный вопрос."
msgstr "Chciałbym/chciałabym… i Czy może pan/pani… łagodzą oficjalne pytanie."

msgid "Czy może pani…? — нейтральная официальная просьба."
msgstr "Czy może pani…? to neutralna oficjalna prośba."

msgid "Czy może pan…? сохраняет нейтральный официальный тон."
msgstr "Czy może pan…? zachowuje neutralny oficjalny ton."

msgid "Do + родительный задаёт крайний срок: do piętnastego maja."
msgstr "Do + dopełniacz wskazuje ostateczny termin: do piętnastego maja."

msgid "Od + дата обозначает начало доступного периода."
msgstr "Od + data oznacza początek dostępnego okresu."

msgid "Proszę + инфинитив: Proszę podpisać formularz."
msgstr "Proszę + bezokolicznik: Proszę podpisać formularz."

msgid "Rubryka — отдельное поле формы."
msgstr "Rubryka to osobne pole formularza."

msgid "Załącznik — дополнительный документ, приложенный к заявлению."
msgstr "Załącznik to dodatkowy dokument dołączony do wniosku."

msgid "В датах день — порядковое числительное, месяц обычно в родительном падеже."
msgstr "W datach dzień jest liczebnikiem porządkowym, a miesiąc zwykle występuje w dopełniaczu."

msgid "В заявлении важно проверить корректность данных."
msgstr "We wniosku należy sprawdzić poprawność danych."

msgid "В подтверждении указан номер дела для проверки статуса."
msgstr "Potwierdzenie zawiera numer sprawy pozwalający sprawdzić jej status."

msgid "В форме не хватает подписи."
msgstr "W formularzu brakuje podpisu."

msgid "Вежливая просьба"
msgstr "Uprzejma prośba"

msgid "Для подтверждения личности Наталия показала паспорт."
msgstr "Aby potwierdzić tożsamość, Natalia pokazała paszport."

msgid "Изготовление карты займёт около двух недель."
msgstr "Przygotowanie karty zajmie około dwóch tygodni."

msgid "Инструкция"
msgstr "Instrukcja"

msgid "Как вежливо попросить повторить?"
msgstr "Jak uprzejmie poprosić o powtórzenie?"

msgid "Как вежливо сказать «Я хотел бы подать заявление»?"
msgstr "Jak uprzejmie poprosić o możliwość złożenia wniosku?"

msgid "Назначенный срок оформляется: termin na + дата."
msgstr "Umówiony termin wyrażamy konstrukcją termin na + data."

msgid "Наталия пришла подать заявление на карту жителя."
msgstr "Natalia przyszła złożyć wniosek o kartę mieszkańca."

msgid "После do в обозначении срока используется родительный: do piętnastego maja."
msgstr "Po do w określeniu terminu używamy dopełniacza: do piętnastego maja."

msgid "После подачи выдают или отправляют подтверждение."
msgstr "Po złożeniu wniosku otrzymujemy potwierdzenie."

msgid "Составьте: Пожалуйста, подпишите форму здесь."
msgstr "Ułóż zdanie: Proszę podpisać formularz tutaj."

msgid "Сотрудница заметила отсутствие даты рождения."
msgstr "Pracownica zauważyła brak daty urodzenia."

msgid "Срок и дата"
msgstr "Termin i data"

msgid "Формальная инструкция строится как proszę + инфинитив."
msgstr "Formalną instrukcję tworzymy za pomocą proszę + bezokolicznik."

msgid "Что нужно проверить перед подачей?"
msgstr "Co należy sprawdzić przed złożeniem wniosku?"

msgid "Что означает załącznik?"
msgstr "Co oznacza załącznik?"

msgid "Что подтверждает подачу заявления?"
msgstr "Co potwierdza złożenie wniosku?"

msgid "бланк; форма"
msgstr "formularz"

msgid "государственное учреждение"
msgstr "urząd"

msgid "действительный"
msgstr "ważny"

msgid "документ, удостоверяющий личность"
msgstr "dokument tożsamości"

msgid "заявление"
msgstr "wniosek"

msgid "не хватать"
msgstr "brakować"

msgid "номер дела"
msgstr "numer sprawy"

msgid "очередь"
msgstr "kolejka"

msgid "персональные данные"
msgstr "dane osobowe"

msgid "подать заявление"
msgstr "złożyć wniosek"

msgid "подпись"
msgstr "podpis"

msgid "поле формы"
msgstr "rubryka"

msgid "получить готовый документ"
msgstr "odebrać gotowy dokument"

msgid "приложение к документу"
msgstr "załącznik"

msgid "Może + инфинитив сообщает о возможности или вероятности."
msgstr "Może + bezokolicznik informuje o możliwości lub prawdopodobieństwie."

msgid "Można говорит о доступной возможности, а może — о вероятности."
msgstr "Można mówi o dostępnej możliwości, a może — o prawdopodobieństwie."

msgid "Należy + инфинитив выражает безличную необходимость; podczas требует родительного падежа."
msgstr "Należy + bezokolicznik wyraża bezosobową konieczność; podczas wymaga dopełniacza."

msgid "Nie wolno + инфинитив выражает запрет."
msgstr "Nie wolno + bezokolicznik wyraża zakaz."

msgid "Nie wolno выражает запрет."
msgstr "Nie wolno wyraża zakaz."

msgid "Prognoza pogody сообщает об ожидаемой погоде."
msgstr "Prognoza pogody informuje o przewidywanej pogodzie."

msgid "Segregować odpady — разделять мусор по видам."
msgstr "Segregować odpady oznacza rozdzielać śmieci według rodzaju."

msgid "Szlak — обозначенный туристический маршрут."
msgstr "Szlak to oznaczona trasa turystyczna."

msgid "Trzeba + инфинитив выражает общую необходимость."
msgstr "Trzeba + bezokolicznik wyraża ogólną konieczność."

msgid "Trzeba/należy + инфинитив: Trzeba zabrać wodę."
msgstr "Trzeba/należy + bezokolicznik: Trzeba zabrać wodę."

msgid "Warto + инфинитив означает полезную рекомендацию."
msgstr "Warto + bezokolicznik wyraża przydatną rekomendację."

msgid "Warto + инфинитив — мягкая рекомендация."
msgstr "Warto + bezokolicznik to łagodne zalecenie."

msgid "Warto советует, а nie wolno запрещает действие."
msgstr "Warto doradza, a nie wolno zakazuje działania."

msgid "Zanieczyszczenie — загрязнение среды."
msgstr "Zanieczyszczenie oznacza obecność szkodliwych substancji w środowisku."

msgid "Бутылку отсортировали в подходящий контейнер."
msgstr "Butelkę wrzucono do odpowiedniego pojemnika."

msgid "Как дать мягкий совет проверить прогноз?"
msgstr "Jak łagodnie doradzić sprawdzenie prognozy?"

msgid "Как сказать «сортировать отходы»?"
msgstr "Jak powiedzieć, że rozdzielamy śmieci według rodzaju?"

msgid "Необходимость"
msgstr "Konieczność"

msgid "Они отправились в национальный парк."
msgstr "Wybrali się do parku narodowego."

msgid "Они увидели тёмные облака и услышали гром."
msgstr "Zobaczyli ciemne chmury i usłyszeli grzmot."

msgid "После дождя и грозы иногда появляется радуга."
msgstr "Po deszczu i burzy czasem pojawia się tęcza."

msgid "После дождя над лесом появилась радуга."
msgstr "Po deszczu nad lasem pojawiła się tęcza."

msgid "Сильный ветер может ломать ветки."
msgstr "Silny wiatr może łamać gałęzie."

msgid "Совет и запрет"
msgstr "Rada i zakaz"

msgid "Составьте: Во время засухи необходимо экономить воду."
msgstr "Ułóż zdanie: Podczas suszy należy oszczędzać wodę."

msgid "Утром ожидалось солнце, а после обеда — гроза."
msgstr "Rano prognozowano słońce, a po południu — burzę."

msgid "Что может вредить воздуху?"
msgstr "Co może szkodzić powietrzu?"

msgid "Что означает prognoza pogody?"
msgstr "Co oznacza prognoza pogody?"

msgid "ветер"
msgstr "wiatr"

msgid "горный маршрут"
msgstr "szlak górski"

msgid "гроза"
msgstr "burza"

msgid "жара"
msgstr "upał"

msgid "загрязнение"
msgstr "zanieczyszczenie"

msgid "защищать природу"
msgstr "chronić przyrodę"

msgid "мороз"
msgstr "mróz"

msgid "облако"
msgstr "chmura"

msgid "окружающая среда"
msgstr "środowisko"

msgid "пейзаж"
msgstr "krajobraz"

msgid "прогноз погоды"
msgstr "prognoza pogody"

msgid "радуга"
msgstr "tęcza"

msgid "сортировать отходы"
msgstr "segregować odpady"

msgid "температура воды"
msgstr "temperatura wody"

msgid "туристический маршрут"
msgstr "szlak turystyczny"

msgid "экономить воду"
msgstr "oszczędzać wodę"

msgid "Kiedy связывает действие или момент с последующим событием."
msgstr "Kiedy łączy czynność lub moment z kolejnym wydarzeniem."

msgid "Kiedy связывает события во времени, а na końcu вводит последний этап."
msgstr "Kiedy łączy wydarzenia w czasie, a na końcu wprowadza ostatni etap."

msgid "Lokalni mieszkańcy — жители конкретного места."
msgstr "Lokalni mieszkańcy to osoby mieszkające w danym miejscu."

msgid "Na końcu вводит последнее событие и завершает последовательность."
msgstr "Na końcu wprowadza ostatnie wydarzenie i zamyka sekwencję."

msgid "Na końcu естественно вводит заключительное событие."
msgstr "Na końcu naturalnie wprowadza wydarzenie kończące opowieść."

msgid "Najpierw вводит первое действие: Najpierw spotkaliśmy się na rynku."
msgstr "Najpierw wprowadza pierwszą czynność: Najpierw spotkaliśmy się na rynku."

msgid "Najpierw вводит первое событие рассказа."
msgstr "Najpierw wprowadza pierwsze wydarzenie opowieści."

msgid "Najpierw …, a następnie … ясно передаёт порядок двух действий."
msgstr "Najpierw …, a następnie … jasno wskazuje kolejność dwóch czynności."

msgid "Potem показывает следующее действие в хронологической последовательности."
msgstr "Potem wskazuje kolejną czynność w porządku chronologicznym."

msgid "Potem, następnie и później показывают следующие этапы рассказа."
msgstr "Potem, następnie i później wskazują kolejne etapy opowieści."

msgid "Później продолжает хронологический рассказ."
msgstr "Później kontynuuje chronologiczną opowieść."

msgid "Zabytek — исторически или культурно ценный объект."
msgstr "Zabytek to obiekt o wartości historycznej lub kulturowej."

msgid "Zwiedzać можно город, музей, замок и другие места."
msgstr "Zwiedzać można miasto, muzeum, zamek i inne miejsca."

msgid "В музее они узнали о старом способе приготовления пряников."
msgstr "W muzeum poznali dawny sposób przygotowywania pierników."

msgid "Выберите естественное описание Польши."
msgstr "Wybierz naturalny opis Polski."

msgid "Гданьск расположен на балтийском побережье Польши."
msgstr "Gdańsk leży na polskim wybrzeżu Bałtyku."

msgid "Группа Майи отправилась на однодневную поездку в Торунь."
msgstr "Grupa Mai wybrała się na jednodniową wycieczkę do Torunia."

msgid "Как естественно завершить рассказ?"
msgstr "Jak naturalnie zakończyć opowieść?"

msgid "Как завершить рассказ о празднике?"
msgstr "Jak zakończyć opowieść o święcie?"

msgid "Как сказать «местные жители»?"
msgstr "Jak określić osoby mieszkające w danym miejscu?"

msgid "Майе запомнились история Торуни и атмосфера местного события."
msgstr "Maja zapamiętała historię Torunia i atmosferę lokalnego wydarzenia."

msgid "На площади проходил местный фестиваль."
msgstr "Na rynku odbywał się lokalny festiwal."

msgid "Начало"
msgstr "Początek"

msgid "О событии говорят: festiwal odbywa się — фестиваль проходит."
msgstr "O wydarzeniu mówimy: festiwal odbywa się."

msgid "Первым событием была встреча с экскурсоводом на площади."
msgstr "Pierwszym wydarzeniem było spotkanie z przewodnikiem na rynku."

msgid "Польское побережье находится на севере, а горные районы — на юге."
msgstr "Polskie wybrzeże leży na północy, a obszary górskie — na południu."

msgid "Продолжение"
msgstr "Kontynuacja"

msgid "Связь и завершение"
msgstr "Powiązanie i zakończenie"

msgid "Составьте: Сначала мы осмотрели замок, а затем пошли на рынок."
msgstr "Ułóż zdanie: Najpierw zwiedziliśmy zamek, a następnie poszliśmy na rynek."

msgid "Что лучше начинает связный рассказ о поездке?"
msgstr "Co najlepiej rozpoczyna spójną opowieść o wycieczce?"

msgid "Что можно zwiedzać?"
msgstr "Co można zwiedzać?"

msgid "Что означает zabytek?"
msgstr "Co oznacza zabytek?"

msgid "главная площадь"
msgstr "rynek"

msgid "горы"
msgstr "góry"

msgid "житель"
msgstr "mieszkaniec"

msgid "исторический памятник"
msgstr "zabytek historyczny"

msgid "местный"
msgstr "lokalny"

msgid "осматривать достопримечательности"
msgstr "zwiedzać"

msgid "памятник истории; достопримечательность"
msgstr "zabytek"

msgid "побережье"
msgstr "wybrzeże"

msgid "праздновать"
msgstr "świętować"

msgid "проходить; состояться"
msgstr "odbywać się"

msgid "регион"
msgstr "region"

msgid "столица"
msgstr "stolica"

msgid "традиция"
msgstr "tradycja"

msgid "Bo вводит причину эмоционального состояния."
msgstr "Bo wprowadza przyczynę stanu emocjonalnego."

msgid "Czy może mi pani powiedzieć…? — нейтральная официальная просьба."
msgstr "Czy może mi pani powiedzieć…? to neutralna oficjalna prośba."

msgid "Film — мужской род, объект заменяется местоимением go."
msgstr "Film ma rodzaj męski, dlatego dopełnienie zastępujemy zaimkiem go."

msgid "Jutro указывает на будущее: kupimy."
msgstr "Jutro wskazuje przyszłość: kupimy."

msgid "Książka — существительное женского рода, поэтому объект заменяется местоимением ją."
msgstr "Książka to rzeczownik rodzaju żeńskiego, dlatego dopełnienie zastępujemy zaimkiem ją."

msgid "Najtańszy — превосходная степень от tani."
msgstr "Najtańszy to stopień najwyższy od tani."

msgid "Napisałem подчёркивает завершённый результат действия."
msgstr "Napisałem podkreśla zakończony rezultat czynności."

msgid "Następnie связывает последовательные события рассказа."
msgstr "Następnie łączy kolejne wydarzenia opowieści."

msgid "Powinieneś + инфинитив выражает рекомендацию."
msgstr "Powinieneś + bezokolicznik wyraża zalecenie."

msgid "Zajmować się требует творительного падежа: naprawą."
msgstr "Zajmować się wymaga narzędnika: naprawą."

msgid "Że вводит содержание сообщения, а bo — его причину."
msgstr "Że wprowadza treść wiadomości, a bo — jej przyczynę."

msgid "Że передаёт содержание, bo — причину, następnie — последовательность. В просьбе используй czy może… или chciałbym/chciałabym…."
msgstr "Że wyraża treść, bo — przyczynę, następnie — kolejność. W prośbie używaj czy może… lub chciałbym/chciałabym…."

msgid "В аптеке она купила сироп и сохранила чек."
msgstr "W aptece kupiła syrop i zachowała paragon."

msgid "В комнате было холодно, потому что не работало отопление."
msgstr "W pokoju było zimno, ponieważ nie działało ogrzewanie."

msgid "В конце Лена подводит итог: спокойствие и ясная просьба помогают."
msgstr "Na końcu Lena podsumowuje: spokój i jasna prośba pomagają."

msgid "Вежливая просьба строится как chciałbym + инфинитив złożyć."
msgstr "Uprzejmą prośbę tworzymy za pomocą chciałbym + bezokolicznik złożyć."

msgid "Время и результат"
msgstr "Czas i rezultat"

msgid "Выбирай прошедшее или будущее по ситуации, а вид глагола — по процессу или завершённому результату."
msgstr "Wybieraj czas przeszły lub przyszły zależnie od sytuacji, a aspekt czasownika — zależnie od procesu lub zakończonego rezultatu."

msgid "Для законченного события используем прошедшее время."
msgstr "Dla zakończonego wydarzenia używamy czasu przeszłego."

msgid "Завершённое событие в прошлом требует формы pojechała."
msgstr "Zakończone wydarzenie w przeszłości wymaga formy pojechała."

msgid "Из-за дождя они выбрали музей вместо долгой прогулки."
msgstr "Z powodu deszczu wybrali muzeum zamiast długiego spaceru."

msgid "Лена планировала выходные и встречу с двоюродной сестрой."
msgstr "Lena planowała weekend i spotkanie z kuzynką."

msgid "Направление к городу передаётся конструкцией do + родительный падеж."
msgstr "Kierunek do miasta wyrażamy konstrukcją do + dopełniacz."

msgid "После nie ma используется родительный падеж: ciepłej wody."
msgstr "Po nie ma używamy dopełniacza: ciepłej wody."

msgid "После przed нужен творительный, после warto — инфинитив."
msgstr "Po przed potrzebny jest narzędnik, a po warto — bezokolicznik."

msgid "После спокойного объяснения Лена получила другую комнату."
msgstr "Po spokojnym wyjaśnieniu Lena otrzymała inny pokój."

msgid "Предлоги и глаголы управляют падежом; niż вводит сравнение, а местоимение заменяет уже названный объект."
msgstr "Przyimki i czasowniki wymagają odpowiednich przypadków; niż wprowadza porównanie, a zaimek zastępuje wcześniej wymienione dopełnienie."

msgid "При сравнении двух предметов используется сравнительная степень + niż."
msgstr "Przy porównaniu dwóch przedmiotów używamy stopnia wyższego + niż."

msgid "Реальное условие относится к будущему: jeśli będzie…, zostaniemy…."
msgstr "Realny warunek dotyczy przyszłości: jeśli będzie…, zostaniemy…."

msgid "Связный ответ"
msgstr "Spójna odpowiedź"

msgid "Составьте: Перед поездкой стоит проверить прогноз."
msgstr "Ułóż zdanie: Przed podróżą warto sprawdzić prognozę."

msgid "Составьте: Я хотел бы подать заявление завтра."
msgstr "Ułóż zdanie: Chciałbym złożyć wniosek jutro."

