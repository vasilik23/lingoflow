msgid "„cytować” — цитировать."
msgstr "„cytować” oznacza przytaczać czyjeś słowa."

msgid "„dowód” — доказательство."
msgstr "„dowód” to informacja potwierdzająca twierdzenie."

msgid "„porównać wyniki” — сравнить результаты."
msgstr "„porównać wyniki” oznacza zestawić rezultaty."

msgid "„przypis” — сноска."
msgstr "„przypis” to dodatkowa informacja przy tekście."

msgid "„sparafrazować” — перефразировать."
msgstr "„sparafrazować” oznacza przekazać sens innymi słowami."

msgid "„streszczenie” — резюме."
msgstr "„streszczenie” to zwięzłe przedstawienie treści."

msgid "„teza” — тезис."
msgstr "„teza” to twierdzenie wymagające uzasadnienia."

msgid "„wiarygodne źródło” — надёжный источник."
msgstr "„wiarygodne źródło” to źródło, któremu można zaufać."

msgid "„wniosek” — вывод."
msgstr "„wniosek” to rezultat rozumowania."

msgid "„zakres badania” — охват исследования."
msgstr "„zakres badania” określa, co objęto badaniem."

msgid "Chociaż вводит уступку, nie można — безличную необходимость."
msgstr "Chociaż wprowadza przyzwolenie, a nie można — bezosobową niemożność lub zakaz."

msgid "Gdyby + past и условная форма выражают нереальное условие."
msgstr "Gdyby z formą czasu przeszłego i trybem warunkowym wyraża warunek nierzeczywisty."

msgid "Niemniej вводит существенную оговорку."
msgstr "Niemniej wprowadza istotne zastrzeżenie."

msgid "O ile вводит условие оценки."
msgstr "O ile wprowadza warunek oceny."

msgid "Tryb warunkowy описывает нереализованную возможность."
msgstr "Tryb warunkowy opisuje niezrealizowaną możliwość."

msgid "Вопрос связывал пользу и возможный ущерб."
msgstr "Pytanie łączyło korzyść z możliwą szkodą."

msgid "Защита"
msgstr "Obrona"

msgid "Исследовательский вопрос ограничивает тему и определяет, какие данные действительно нужны."
msgstr "Pytanie badawcze ogranicza temat i określa, jakie dane są rzeczywiście potrzebne."

msgid "Критерии были измеримыми."
msgstr "Kryteria były mierzalne."

msgid "На вопрос сначала ответь прямо, затем назови доказательство и границы вывода."
msgstr "Najpierw odpowiedz na pytanie wprost, potem wskaż dowód i granice wniosku."

msgid "Обратная связь улучшила план."
msgstr "Informacja zwrotna poprawiła plan."

msgid "Ответ был прямым и доказательным."
msgstr "Odpowiedź była bezpośrednia i poparta dowodami."

msgid "Результат нельзя автоматически обобщать."
msgstr "Wyniku nie można automatycznie uogólniać."

msgid "Составьте: Если бы мы повторили проект, мы бы раньше собрали обратную связь."
msgstr "Ułóż zdanie: gdybyśmy powtórzyli projekt, wcześniej zebralibyśmy informację zwrotną."

msgid "Составьте: Хотя результат подтвердил тезис, нельзя игнорировать ограничение выборки."
msgstr "Ułóż zdanie: chociaż wynik potwierdził tezę, nie można ignorować ograniczenia próby."

msgid "Тезис, основание, пример и признание ограничения создают убедительную структуру."
msgstr "Teza, uzasadnienie, przykład i uznanie ograniczenia tworzą przekonującą strukturę."

msgid "Финал подчёркивает честную аргументацию."
msgstr "Zakończenie podkreśla uczciwą argumentację."

