msgstr "temperatura"

msgid "чувствовать себя"
msgstr "czuć się — mieć określone samopoczucie"

msgid "Boli сочетается с единственным числом, bolą — с множественным."
msgstr "Boli łączy się z liczbą pojedynczą, a bolą — z liczbą mnogą."

msgid "Jak dojść do…? — естественный вопрос о маршруте."
msgstr "Jak dojść do…? to naturalne pytanie o trasę."

msgid "Mam na imię… — базовая форма представления."
msgstr "Mam na imię… to podstawowa forma przedstawiania się."

msgid "Plecy имеют форму множественного числа."
msgstr "Plecy mają formę liczby mnogiej."

msgid "Siostra — женский род, поэтому moja."
msgstr "Siostra ma rodzaj żeński, dlatego używamy moja."

msgid "W poniedziałek o ósmej; mogę/muszę + инфинитив; boli + одно, bolą + множественное число."
msgstr "W poniedziałek o ósmej; mogę/muszę + bezokolicznik; boli + liczba pojedyncza, bolą + liczba mnoga."

msgid "Визит назначен на четверг в девять."
msgstr "Wizyta jest umówiona na czwartek na dziewiątą."

msgid "Во множественном числе о людях: moi rodzice."
msgstr "W liczbie mnogiej o osobach: moi rodzice."

msgid "Время, возможность и здоровье"
msgstr "Czas, możliwość i zdrowie"

msgid "Для Anna/ona нужна форма wstaje."
msgstr "Dla Anna/ona potrzebna jest forma wstaje."

msgid "Для ja употребляем wstaję."
msgstr "Dla ja używamy wstaję."

msgid "Для ja форма być — jestem."
msgstr "Dla ja forma czasownika być to jestem."

msgid "Для on форма глагола mówić — mówi."
msgstr "Dla on forma czasownika mówić to mówi."

msgid "Как естественно представиться?"
msgstr "Jak naturalnie się przedstawić?"

msgid "Как спросить дорогу?"
msgstr "Jak zapytać o drogę?"

msgid "О себе"
msgstr "O sobie"

msgid "Они обсуждают семью, работу и выходные."
msgstr "Rozmawiają o rodzinie, pracy i weekendzie."

msgid "После lubię действие выражается инфинитивом."
msgstr "Po lubię czynność wyrażamy bezokolicznikiem."

msgid "После muszę ставим инфинитив."
msgstr "Po muszę stawiamy bezokolicznik."

msgid "После poproszę предмет стоит в винительном падеже: kawę."
msgstr "Po poproszę rzecz występuje w bierniku: kawę."

msgid "После количества употребляется родительный падеж: kilogram jabłek."
msgstr "Po określeniu ilości używamy dopełniacza: kilogram jabłek."

msgid "Предмет находится na stole."
msgstr "Przedmiot znajduje się na stole."

msgid "Предметы и места"
msgstr "Przedmioty i miejsca"

msgid "Проверяй род и падеж: moja siostra, poproszę kawę, w domu, na stole."
msgstr "Sprawdzaj rodzaj i przypadek: moja siostra, poproszę kawę, w domu, na stole."

msgid "С днём употребляем w, со временем — o."
msgstr "Z dniem używamy w, a z godziną — o."

msgid "Согласуй лицо глагола: jestem, mieszkam, pracuję, lubię; для on/ona: jest, mieszka, pracuje, lubi."
msgstr "Dopasuj osobę czasownika: jestem, mieszkam, pracuję, lubię; dla on/ona: jest, mieszka, pracuje, lubi."

msgid "Фраза означает «Я умею справиться на польском»."
msgstr "To zdanie oznacza, że potrafię poradzić sobie po polsku."

msgid "Что показывает готовность действовать самостоятельно?"
msgstr "Co pokazuje gotowość do samodzielnego działania?"

msgid "Это её покупки."
msgstr "To jej zakupy."

msgid "договариваться о встрече"
msgstr "umawiać się na spotkanie"

msgid "дорога; путь"
msgstr "droga; trasa"

msgid "нуждаться"
msgstr "potrzebować"

msgid "попросить"
msgstr "poprosić"

msgid "представиться"
msgstr "przedstawić się"

msgid "справиться"
msgstr "poradzić sobie"

msgid "уладить; сделать"
msgstr "załatwić — zrobić lub rozwiązać coś"

msgid "Как естественно сказать «Меня зовут Лена»?"
msgstr "Jak naturalnie przedstawić się jako Lena?"

msgid "Как спросить «Как дойти до вокзала?»"
msgstr "Jak zapytać, jak dojść do dworca?"

msgid "Как спросить «Что ты любишь делать в выходные?»"
msgstr "Jak zapytać rozmówcę o ulubione zajęcia w weekend?"

msgid "Co robiłeś/robiłaś w weekend? — вопрос о завершённом прошлом."
msgstr "Co robiłeś/robiłaś w weekend? to pytanie o miniony weekend."

msgid "Ewa — женский род: czytała."
msgstr "Ewa to kobieta, dlatego używamy czytała."

msgid "Ja (женщина) długo ___."
msgstr "Ja (kobieta) długo ___."

msgid "Ja (мужчина) ___ weekend w domu."
msgstr "Ja (mężczyzna) ___ weekend w domu."

msgid "My (мужчина и женщина) ___ w Krakowie."
msgstr "My (mężczyzna i kobieta) ___ w Krakowie."

msgid "My (смешанная группа) ___ późno."
msgstr "My (grupa mieszana) ___ późno."

msgid "Paweł — мужской род: oglądał."
msgstr "Paweł to mężczyzna, dlatego używamy oglądał."

msgid "Przedwczoraj — позавчера."
msgstr "Przedwczoraj to dzień przed wczorajszym dniem."

msgid "В первом абзаце прямо сказано: Kasia pojechała pociągiem do Wrocławia."
msgstr "Pierwszy akapit mówi wprost: Kasia pojechała pociągiem do Wrocławia."

msgid "В субботу подруги посетили музей и увидели рыночную площадь."
msgstr "W sobotę koleżanki odwiedziły muzeum i zobaczyły rynek."

msgid "Говорящая женщина выбирает форму odpoczywałam."
msgstr "Kobieta wybiera formę odpoczywałam."

msgid "Говорящий выбирает форму по своему роду: robiłem/byłem или robiłam/byłam."
msgstr "Osoba mówiąca wybiera formę zgodną ze swoim rodzajem: robiłem/byłem albo robiłam/byłam."

msgid "Группа женщин: zostały."
msgstr "Grupa kobiet: zostały."

msgid "Группа мужчин: poszli."
msgstr "Grupa mężczyzn: poszli."

msgid "Для Ania нужна женская форма poszła."
msgstr "Dla Ani potrzebna jest forma żeńska poszła."

msgid "Для группы с мужчиной: byliśmy, robili; для группы только из женщин/предметов: byłyśmy, robiły."
msgstr "Dla grupy z mężczyzną: byliśmy, robili; dla grupy tylko kobiet lub przedmiotów: byłyśmy, robiły."

msgid "Для группы только из женщин нужна форма niemęskoosobowa: zwiedziły."
msgstr "Dla grupy samych kobiet potrzebna jest forma niemęskoosobowa: zwiedziły."

msgid "Для смешанной группы употребляется форма męskoosobowa: byliśmy."
msgstr "Dla grupy mieszanej używamy formy męskoosobowej: byliśmy."

msgid "Для смешанной группы: wróciliśmy."
msgstr "Dla grupy mieszanej: wróciliśmy."

msgid "Как спросить о прошлых выходных?"
msgstr "Jak zapytać o miniony weekend?"

msgid "Мужская форма первого лица: spędziłem."
msgstr "Męska forma pierwszej osoby: spędziłem."

msgid "Мы и они"
msgstr "My i oni"

msgid "После отдыха Павел в понедельник чувствовал прилив энергии."
msgstr "Po odpoczynku Paweł w poniedziałek miał dużo energii."

msgid "Союз więc связывает причину и результат: было солнечно, поэтому они много гуляли."
msgstr "Więc łączy przyczynę i skutek: było słonecznie, więc dużo spacerowali."

msgid "Текст перечисляет два действия Павла дома: приготовил обед и посмотрел два фильма."
msgstr "Tekst wymienia dwie czynności Pawła w domu: ugotował obiad i obejrzał dwa filmy."

msgid "Что означает przedwczoraj?"
msgstr "Co oznacza przedwczoraj?"

msgid "Я"
msgstr "Ja"

msgid "в последнее время"
msgstr "ostatnio"

msgid "вернуться"
msgstr "wrócić"

msgid "встретиться"
msgstr "spotkać się"

