msgid "Dorastać — постепенно становиться взрослым."
msgstr "Dorastać oznacza stopniowo stawać się dorosłym."

msgid "Jeździł описывает повторение, został — единичный завершённый выбор."
msgstr "Jeździł opisuje powtarzające się czynności, a został — jednorazowy, zakończony wybór."

msgid "Najpierw и potem выстраивают хронологию; założyła передаёт достигнутый результат."
msgstr "Najpierw i potem porządkują wydarzenia chronologicznie; założyła wskazuje osiągnięty rezultat."

msgid "Najpierw, następnie, z czasem и w końcu помогают показать развитие событий."
msgstr "Najpierw, następnie, z czasem i w końcu pomagają pokazać rozwój wydarzeń."

msgid "Okazać się сообщает, каким что-либо оказалось."
msgstr "Okazać się informuje, jakie coś było w rzeczywistości."

msgid "Początkowo вводит начальный этап истории."
msgstr "Początkowo wprowadza początkowy etap historii."

msgid "Punkt zwrotny меняет дальнейшее развитие событий."
msgstr "Punkt zwrotny zmienia dalszy przebieg wydarzeń."

msgid "Ukończyła подчёркивает завершённый результат."
msgstr "Ukończyła podkreśla zakończony rezultat."

msgid "Ukończyłem ясно обозначает завершённый этап."
msgstr "Ukończyłem wyraźnie wskazuje zakończony etap."

msgid "Wpłynąć na — оказать влияние на что-либо."
msgstr "Wpłynąć na oznacza wywrzeć na coś wpływ."

msgid "Wpłynąć требует na + винительный падеж: na moje życie."
msgstr "Wpłynąć łączy się z na i biernikiem: na moje życie."

msgid "В финале она связывает опыт с пониманием собственных целей."
msgstr "Na końcu łączy doświadczenie ze zrozumieniem własnych celów."

msgid "Йоанна выросла в Белостоке."
msgstr "Joanna dorastała w Białymstoku."

msgid "Как сказать «поворотный момент»?"
msgstr "Jak powiedzieć „moment, który zmienia dalszy bieg wydarzeń”?"

msgid "Как сказать о завершённом образовании?"
msgstr "Jak powiedzieć o ukończeniu edukacji?"

msgid "Несовершенный вид pracowała описывает длительный фон прошлого."
msgstr "Forma niedokonana pracowała opisuje długotrwałe tło wydarzeń z przeszłości."

msgid "Несовершенный вид описывает длительность, повторение и фон: pracowała, jeździł."
msgstr "Aspekt niedokonany opisuje trwanie, powtarzanie i tło wydarzeń: pracowała, jeździł."

msgid "Одно завершённое событие предшествует другому: ukończył."
msgstr "Jedno zakończone wydarzenie poprzedza drugie: ukończył."

msgid "Она изучала архитектуру в Варшаве."
msgstr "Studiowała architekturę w Warszawie."

msgid "Она решила заниматься общественными пространствами."
msgstr "Postanowiła zajmować się przestrzeniami publicznymi."

msgid "Первая работа дала ей практический опыт."
msgstr "Pierwsza praca dała jej praktyczne doświadczenie."

msgid "Работа над библиотекой изменила её профессиональные цели."
msgstr "Praca nad biblioteką zmieniła jej cele zawodowe."

msgid "Связная история"
msgstr "Spójna opowieść"

msgid "Совершенный вид выделяет завершённый этап: ukończyła, podjął, osiągnęli."
msgstr "Aspekt dokonany podkreśla zakończony etap: ukończyła, podjął, osiągnęli."

msgid "Составьте: Сначала она работала в школе, а потом открыла фирму."
msgstr "Ułóż zdanie: najpierw pracowała w szkole, a potem założyła firmę."

msgid "Составьте: Этот опыт сильно повлиял на мою жизнь."
msgstr "Ułóż zdanie: to doświadczenie mocno wpłynęło na moje życie."

msgid "Фон и процесс"
msgstr "Tło i proces"

msgid "Хронологические маркеры делают рассказ связным."
msgstr "Określenia porządkujące wydarzenia chronologicznie nadają opowieści spójność."

msgid "Что лучше связывает биографический рассказ?"
msgstr "Co najlepiej zapewnia spójność opowieści biograficznej?"

msgid "Что означает dorastać?"
msgstr "Co oznacza dorastać?"

msgid "важное событие"
msgstr "ważne wydarzenie"

