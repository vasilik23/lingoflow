msgid "Chciałbym porozmawiać... звучит профессионально и не категорично."
msgstr "Chciałbym porozmawiać... brzmi profesjonalnie i nie jest kategoryczne."

msgid "Chciałbym — вежливая условная форма; dowiedzieć się o требует местного падежа."
msgstr "Chciałbym to uprzejma forma warunkowa; dowiedzieć się o łączy się z miejscownikiem."

msgid "Chciałbym, mógłby Pan и czy moglibyśmy смягчают просьбу в профессиональной беседе."
msgstr "Chciałbym, mógłby Pan i czy moglibyśmy łagodzą prośbę w rozmowie zawodowej."

msgid "Czy moglibyśmy... — нейтральная формальная просьба в условном наклонении."
msgstr "Czy moglibyśmy... to neutralna, formalna prośba w trybie warunkowym."

msgid "Dotrzymać terminu — выполнить работу в установленный срок."
msgstr "Dotrzymać terminu oznacza wykonać pracę w ustalonym czasie."

msgid "Gdyby + прошедшая форма с частицей by описывает воображаемую ситуацию: Gdybym dostał..., zrobiłbym..."
msgstr "Gdyby z formą czasu przeszłego i cząstką by opisuje sytuację wyobrażoną: Gdybym dostał..., zrobiłbym..."

msgid "Gdyby вводит условие, а wziąłbym — его возможный результат; wziąć udział w + miejscownik."
msgstr "Gdyby wprowadza warunek, a wziąłbym — jego możliwy skutek; wziąć udział w łączy się z miejscownikiem."

msgid "Gdybym... nauczyłabym — согласованные формы условного наклонения."
msgstr "Gdybym... nauczyłabym to zgodne formy trybu warunkowego."

msgid "Mógłby Pan... — формальная вежливая просьба."
msgstr "Mógłby Pan... to formalna, uprzejma prośba."

msgid "Na pani miejscu + tryb warunkowy служит вежливым советом."
msgstr "Na pani miejscu z trybem warunkowym służy do uprzejmego udzielania rady."

msgid "Otrzymać awans — получить повышение."
msgstr "Otrzymać awans oznacza objąć wyższe stanowisko."

msgid "Stanowisko — место или должность в организации."
msgstr "Stanowisko to miejsce lub funkcja w organizacji."

msgid "Uprzejmie proszę o... и Zwracam się z prośbą o... — нейтральные формулы обращения."
msgstr "Uprzejmie proszę o... i Zwracam się z prośbą o... to neutralne formuły zwracania się do adresata."

msgid "Uprzejmie proszę o... — стандартная формула официальной переписки."
msgstr "Uprzejmie proszę o... to standardowa formuła korespondencji oficjalnej."

msgid "Wykazać inicjatywę — самостоятельно предложить или начать полезное действие."
msgstr "Wykazać inicjatywę oznacza samodzielnie zaproponować lub rozpocząć pożyteczne działanie."

msgid "В предложении были наставник и бюджет на обучение."
msgstr "Oferta obejmowała wsparcie mentora i budżet na szkolenia."

msgid "Ей не хватало возможностей развития и ответственности."
msgstr "Brakowało jej możliwości rozwoju i odpowiedzialności."

msgid "Как вежливо начать просьбу о повышении зарплаты?"
msgstr "Jak uprzejmie rozpocząć prośbę o podwyżkę?"

msgid "Как официально попросить о встрече?"
msgstr "Jak oficjalnie poprosić o spotkanie?"

msgid "Кандидат начинает процесс с отправки резюме."
msgstr "Kandydat rozpoczyna proces od wysłania CV."

msgid "Лена добилась результата благодаря подготовке и оценке возможностей развития."
msgstr "Lena osiągnęła rezultat dzięki przygotowaniu i ocenie możliwości rozwoju."

msgid "Обучение развивает профессиональные компетенции."
msgstr "Szkolenie rozwija kompetencje zawodowe."

msgid "Она подготовила конкретные достижения и прошла курс."
msgstr "Przygotowała konkretne osiągnięcia i ukończyła kurs."

msgid "Она показала инициативу и спокойную коммуникацию."
msgstr "Wykazała inicjatywę i spokojnie się komunikowała."

msgid "Официальное письмо"
msgstr "List oficjalny"

msgid "Руководитель попросил привести пример решения рабочей проблемы."
msgstr "Przełożony poprosił o przykład rozwiązania problemu w pracy."

msgid "Составьте: Если бы компания предложила обучение, я бы принял участие."
msgstr "Ułóż zdanie: gdyby firma zaproponowała szkolenie, wziąłbym w nim udział."

msgid "Составьте: Я хотел бы узнать больше об обязанностях."
msgstr "Ułóż zdanie: chciałbym dowiedzieć się więcej o obowiązkach."

msgid "Условие"
msgstr "Warunek"

msgid "Условное наклонение образуется формой прошедшего времени с частицей by: ukończyłbym."
msgstr "Tryb warunkowy tworzy się z formy czasu przeszłego i cząstki by: ukończyłbym."

msgid "Что означает stanowisko?"
msgstr "Co oznacza stanowisko?"

msgid "внедрить; ввести в курс дела"
msgstr "wdrożyć, wprowadzić w obowiązki"

msgid "должность"
msgstr "stanowisko"

msgid "обучение; тренинг"
msgstr "szkolenie, trening"

msgid "обязанности"
msgstr "obowiązki"

msgid "повышение зарплаты"
msgstr "podwyżka"

msgid "подбор персонала"
msgstr "rekrutacja"

msgid "профессиональное развитие"
msgstr "rozwój zawodowy"

msgid "профессиональный опыт"
msgstr "doświadczenie zawodowe"

msgid "проявить инициативу"
msgstr "wykazać inicjatywę"

msgid "собеседование"
msgstr "rozmowa kwalifikacyjna"

msgid "совещание"
msgstr "zebranie"

msgid "Chociaż вводит уступительное придаточное."
msgstr "Chociaż wprowadza zdanie podrzędne przyzwalające."

msgid "Chociaż вводит уступку: трудность не отменяет положительный результат."
msgstr "Chociaż wprowadza przyzwolenie: trudność nie wyklucza pozytywnego rezultatu."

msgid "Chociaż соединяет уступку с главным сообщением; uczyć się требует родительного падежа."
msgstr "Chociaż łączy przyzwolenie z główną informacją; uczyć się łączy się z dopełniaczem."

msgid "Kształcenie — организованный процесс получения знаний и навыков."
msgstr "Kształcenie to zorganizowany proces zdobywania wiedzy i umiejętności."

msgid "Pogłębiać wiedzę — устойчивое сочетание «углублять знания»."
msgstr "Pogłębiać wiedzę to stałe połączenie oznaczające poszerzanie i lepsze rozumienie wiedzy."

msgid "Ponieważ называет причину важности практики."
msgstr "Ponieważ wskazuje przyczynę, dla której praktyka jest ważna."

msgid "Robić postępy — постепенно улучшать результаты."
msgstr "Robić postępy oznacza stopniowo poprawiać wyniki."

msgid "Zaliczyć przedmiot — выполнить требования и получить зачёт."
msgstr "Zaliczyć przedmiot oznacza spełnić wymagania i uzyskać zaliczenie."

msgid "Выберите естественное сочетание."
msgstr "Wybierz naturalne połączenie wyrazów."

msgid "Главной трудностью было совмещать работу и систематические занятия."
msgstr "Główną trudnością było łączenie pracy z systematycznymi zajęciami."

msgid "Ей был нужен польский для профессиональных встреч."
msgstr "Potrzebowała polskiego podczas spotkań zawodowych."

msgid "Конкретная обратная связь объясняет, что именно исправить."
msgstr "Konkretna informacja zwrotna wyjaśnia, co dokładnie poprawić."

msgid "Косвенное утверждение после powiedziała вводится że."
msgstr "Twierdzenie w mowie zależnej po powiedziała wprowadza się spójnikiem że."

msgid "Косвенный общий вопрос требует czy."
msgstr "Pytanie rozstrzygające w mowie zależnej wymaga czy."

msgid "Лена связала прогресс с регулярной осмысленной практикой."
msgstr "Lena powiązała postępy z regularną, świadomą praktyką."

msgid "Обратная связь показывала и успех, и понятный следующий шаг."
msgstr "Informacja zwrotna wskazywała zarówno sukces, jak i zrozumiały kolejny krok."

msgid "Общий вопрос в косвенной речи вводится союзом czy."
msgstr "Pytanie rozstrzygające w mowie zależnej wprowadza się spójnikiem czy."

msgid "Общий вопрос в косвенной речи вводится через czy: Zapytała, czy rozumiem."
msgstr "Pytanie rozstrzygające w mowie zależnej wprowadza się przez czy: Zapytała, czy rozumiem."

msgid "Она отметила, что впервые выступала без заранее написанного текста."
msgstr "Zauważyła, że po raz pierwszy występowała bez wcześniej napisanego tekstu."

msgid "Первый вариант естественно описывает регулярность и самостоятельную проверку прогресса."
msgstr "Pierwsza odpowiedź naturalnie opisuje regularność i samodzielne sprawdzanie postępów."

msgid "После powiedzieć, wyjaśnić и dodać содержание высказывания обычно вводится через że."
msgstr "Po powiedzieć, wyjaśnić i dodać treść wypowiedzi zwykle wprowadza się przez że."

msgid "После wyjaśnił утверждение вводится że; будущее действие выражено otrzymamy."
msgstr "Po wyjaśnił twierdzenie wprowadza się przez że; przyszłą czynność wyraża otrzymamy."

msgid "Преподаватель предложил небольшие практические задания из её рабочего контекста."
msgstr "Prowadzący zaproponował niewielkie zadania praktyczne związane z jej pracą."

msgid "Составьте: Преподаватель объяснил, что обратную связь мы получим завтра."
msgstr "Ułóż zdanie: nauczyciel wyjaśnił, że informację zwrotną otrzymamy jutro."

msgid "Составьте: Хотя лекции полезны, я больше всего учусь на практике."
msgstr "Ułóż zdanie: chociaż wykłady są przydatne, najwięcej uczę się w praktyce."

msgid "Утверждение"
msgstr "Twierdzenie"

msgid "Утверждение передаётся через że без кавычек."
msgstr "Twierdzenie przekazuje się przez że, bez cudzysłowu."

msgid "Что означает kształcenie?"
msgstr "Co oznacza kształcenie?"

msgid "делать успехи"
msgstr "robić postępy"

msgid "лекция"
msgstr "wykład"

msgid "направление обучения"
msgstr "kierunek studiów"

msgid "образование и обучение"
msgstr "edukacja i kształcenie"

msgid "образование; обучение"
msgstr "edukacja, kształcenie"

msgid "обратная связь"
msgstr "informacja zwrotna"

msgid "оценка"
msgstr "ocena"

msgid "практические занятия"
msgstr "zajęcia praktyczne"

msgid "развивать навыки"
msgstr "rozwijać umiejętności"

msgid "сдать предмет"
msgstr "zaliczyć przedmiot"

msgid "систематический"
msgstr "systematyczny"

msgid "сотрудничество"
msgstr "współpraca"

msgid "стипендия"
msgstr "stypendium"

msgid "требование"
msgstr "wymaganie"

msgid "углублять знания"
msgstr "pogłębiać wiedzę"

msgid "Dogadać się означает прийти к взаимопониманию."
msgstr "Dogadać się oznacza dojść do wzajemnego zrozumienia."

msgid "Liczyć na kogoś означает рассчитывать на человека."
msgstr "Liczyć na kogoś oznacza oczekiwać wsparcia od tej osoby."

msgid "Opowiedzieć komuś требует дательного падежа: której."
msgstr "Opowiedzieć komuś łączy się z celownikiem: której."

msgid "Pójść na kompromis — найти решение через взаимные уступки."
msgstr "Pójść na kompromis oznacza znaleźć rozwiązanie dzięki wzajemnym ustępstwom."

msgid "Szanować czyjeś granice — устойчивое выражение об уважении личных границ."
msgstr "Szanować czyjeś granice to stałe wyrażenie dotyczące poszanowania granic osobistych."

msgid "Szczery описывает человека, который говорит открыто и правдиво."
msgstr "Szczery opisuje osobę, która mówi otwarcie i zgodnie z prawdą."

msgid "Wyższy od brata и bardziej cierpliwa niż koleżanka показывают различие; tak samo… jak — равенство."
msgstr "Wyższy od brata i bardziej cierpliwa niż koleżanka pokazują różnicę; tak samo… jak — równość."

msgid "Герои поняли, что различия можно обсуждать и согласовывать."
msgstr "Bohaterowie zrozumieli, że różnice można omawiać i uzgadniać."

msgid "Глагол zaufać требует дательного падежа; форма женского относительного местоимения — której."
msgstr "Czasownik zaufać łączy się z celownikiem; żeńska forma zaimka względnego to której."

msgid "Конфликт начался из-за разных ожиданий от поездки."
msgstr "Konflikt rozpoczął się z powodu różnych oczekiwań wobec podróży."

msgid "Кто и который"
msgstr "Kto i który"

msgid "Местоимение является подлежащим во множественном числе, поэтому нужны którzy."
msgstr "Zaimek jest podmiotem w liczbie mnogiej, dlatego potrzebna jest forma którzy."

msgid "Михал предложил по очереди объяснить потребности."
msgstr "Michał zaproponował, żeby po kolei wyjaśnili swoje potrzeby."

msgid "Оле хотелось спокойного отдыха без спешки."
msgstr "Ola chciała spokojnego wypoczynku bez pośpiechu."

msgid "Они объединили ожидания обоих в одном плане."
msgstr "Połączyli oczekiwania obojga w jednym planie."

msgid "После сравнительной степени прилагательного естественна конструкция od + родительный падеж."
msgstr "Po stopniu wyższym przymiotnika naturalna jest konstrukcja od z dopełniaczem."

msgid "Равенство признака выражается tak samo… jak."
msgstr "Równość cechy wyraża się przez tak samo… jak."

msgid "Равная степень сравнения выражается конструкцией tak samo… jak."
msgstr "Równy stopień nasilenia cechy wyraża konstrukcja tak samo… jak."

msgid "Сначала Оля перебивала и защищала только свой вариант."
msgstr "Początkowo Ola przerywała i broniła tylko swojego pomysłu."

msgid "Составьте: Моя сестра спокойнее меня, но мы хорошо понимаем друг друга."
msgstr "Ułóż zdanie: moja siostra jest spokojniejsza ode mnie, ale dobrze się rozumiemy."

msgid "Составьте: Это друг, на которого я всегда могу рассчитывать."
msgstr "Ułóż zdanie: to przyjaciel, na którego zawsze mogę liczyć."

msgid "Спокойный искренний разговор позволяет объяснить позиции."
msgstr "Spokojna, szczera rozmowa pozwala wyjaśnić stanowiska."

msgid "Сравнение требует spokojniejsza ode mnie, а взаимное действие — się rozumiemy."
msgstr "Porównanie wymaga spokojniejsza ode mnie, a wzajemne działanie — się rozumiemy."

msgid "Сравнительная степень с od требует родительного падежа."
msgstr "Stopień wyższy z od łączy się z dopełniaczem."

msgid "Управление"
msgstr "Łączliwość wyrazów"

msgid "Устойчивое выражение liczyć na kogoś требует na + винительный; для лица мужского рода — na którego."
msgstr "Stałe wyrażenie liczyć na kogoś wymaga na z biernikiem; w odniesieniu do osoby rodzaju męskiego — na którego."

msgid "Устойчивое выражение liczyć na требует винительного: przyjaciel, na którego liczę."
msgstr "Stałe wyrażenie liczyć na łączy się z biernikiem: przyjaciel, na którego liczę."

msgid "Форма który меняется по роду, числу и роли: osoba, która pomaga; kolega, któremu ufam."
msgstr "Forma który zmienia się zależnie od rodzaju, liczby i roli: osoba, która pomaga; kolega, któremu ufam."

msgid "Хорошие отношения предполагают взаимное слушание и готовность уступать."
msgstr "Dobre relacje zakładają wzajemne słuchanie i gotowość do ustępstw."

msgid "Что означает pójść na kompromis?"
msgstr "Co oznacza pójść na kompromis?"

msgid "договориться"
msgstr "dogadać się"

msgid "доказать свою правоту"
msgstr "udowodnić swoją rację"

msgid "отличаться от"
msgstr "różnić się od"

msgid "поддержать"
msgstr "wesprzeć"

msgid "пойти на взаимные уступки"
msgstr "poczynić wzajemne ustępstwa"

msgid "пойти на компромисс"
msgstr "pójść na kompromis"

msgid "прекратить общение"
msgstr "zerwać kontakt"

msgid "рассчитывать на кого-либо"
msgstr "liczyć na kogoś"

msgid "терпеливый"
msgstr "cierpliwy"

msgid "уважать чьи-либо границы"
msgstr "szanować czyjeś granice"

msgid "упрямый"
msgstr "uparty"

msgid "уступить"
msgstr "ustąpić"

msgid "характер"
msgstr "charakter"

msgid "чуткий"
msgstr "wrażliwy"

msgid "Radzić sobie ze stresem — устойчивое выражение «справляться со стрессом»."
msgstr "Radzić sobie ze stresem to stałe wyrażenie oznaczające skuteczne reagowanie na stres."

msgid "Trzeba, warto, można и powinno się соединяются с инфинитивом и не называют конкретного исполнителя."
msgstr "Trzeba, warto, można i powinno się łączą się z bezokolicznikiem i nie wskazują konkretnego wykonawcy."

msgid "Udało mi się + совершенный инфинитив передаёт достигнутый результат; zrezygnować требует z + родительный."
msgstr "Udało mi się z bezokolicznikiem dokonanym wskazuje osiągnięty rezultat; zrezygnować łączy się z z i dopełniaczem."

msgid "Utrzymać nawyk — продолжать выбранное действие регулярно."
msgstr "Utrzymać nawyk oznacza regularnie kontynuować wybrane działanie."

msgid "Wysypiać się означает получать достаточно сна."
msgstr "Wysypiać się oznacza spać wystarczająco długo."

msgid "Wyберите естественное сочетание."
msgstr "Wybierz naturalne połączenie wyrazów."

msgid "Безличная конструкция nie powinno się + инфинитив выражает общую рекомендацию."
msgstr "Konstrukcja bezosobowa nie powinno się z bezokolicznikiem wyraża ogólne zalecenie."

msgid "Его беспокоили усталость и плохой сон."
msgstr "Niepokoiły go zmęczenie i zły sen."

msgid "Завершённый результат после udało się выражается совершенным инфинитивом wykonać."
msgstr "Zakończony rezultat po udało się wyraża dokonany bezokolicznik wykonać."

msgid "Куба выбрал короткую прогулку после работы."
msgstr "Kuba wybrał krótki spacer po pracy."

msgid "Небольшие постепенные изменения легче и безопаснее поддерживать."
msgstr "Niewielkie, stopniowe zmiany łatwiej i bezpieczniej utrzymać."

msgid "Несовершенный вид показывает повторение или длительность: regularnie ćwiczyć, ograniczać stres."
msgstr "Aspekt niedokonany wskazuje powtarzanie lub trwanie: regularnie ćwiczyć, ograniczać stres."

msgid "Общая рекомендация"
msgstr "Ogólne zalecenie"

msgid "Общая рекомендация строится как nie powinno się + несовершенный инфинитив."
msgstr "Ogólne zalecenie tworzy się za pomocą nie powinno się i bezokolicznika niedokonanego."

msgid "Однократная рекомендация с результатом требует совершенного вида odłożyć."
msgstr "Jednorazowe zalecenie z rezultatem wymaga aspektu dokonanego: odłożyć."

msgid "Он взялся сразу за слишком много сложных изменений."
msgstr "Podjął się od razu zbyt wielu trudnych zmian."

msgid "Отдых нужен при сигналах усталости, а не после переутомления."
msgstr "Odpoczynek jest potrzebny przy oznakach zmęczenia, a nie dopiero po przemęczeniu."

msgid "Повторяющееся действие в прошлом выражается несовершенным видом ćwiczyłem."
msgstr "Powtarzającą się czynność w przeszłości wyraża aspekt niedokonany: ćwiczyłem."

msgid "После безличного powinno się нужен инфинитив; длительное действие — pracować."
msgstr "Po bezosobowym powinno się potrzebny jest bezokolicznik; czynność długotrwała — pracować."

msgid "Процесс"
msgstr "Proces"

msgid "Регулярная прогулка улучшила сон и уровень энергии."
msgstr "Regularny spacer poprawił sen i poziom energii."

msgid "Регулярность и наблюдение за прогрессом помогают закрепить привычку."
msgstr "Regularność i obserwowanie postępów pomagają utrwalić nawyk."

msgid "Регулярный процесс в прошлом требует несовершенного вида ćwiczyłam."
msgstr "Regularny proces w przeszłości wymaga aspektu niedokonanego: ćwiczyłam."

msgid "Рекомендация о конкретном результате использует совершенный инфинитив ograniczyć."
msgstr "Zalecenie dotyczące konkretnego rezultatu wykorzystuje dokonany bezokolicznik ograniczyć."

msgid "Совершенный вид wykonałem подчёркивает завершённый набор упражнений."
msgstr "Aspekt dokonany wykonałem podkreśla ukończony zestaw ćwiczeń."

msgid "Совершенный вид подчёркивает достигнутую границу: wykonać plan, zrezygnować z napojów."
msgstr "Aspekt dokonany podkreśla osiągnięcie granicy: wykonać plan, zrezygnować z napojów."

msgid "Составьте: Вчера мне удалось отказаться от сладких напитков."
msgstr "Ułóż zdanie: wczoraj udało mi się zrezygnować ze słodkich napojów."

msgid "Составьте: Не следует менять все привычки одновременно."
msgstr "Ułóż zdanie: nie powinno się zmieniać wszystkich nawyków jednocześnie."

msgid "Специалист предложила начать с одного небольшого действия."
msgstr "Specjalistka zaproponowała rozpoczęcie od jednego niewielkiego działania."

msgid "Текст подчёркивает постепенность, наблюдение и восстановление."
msgstr "Tekst podkreśla stopniowe zmiany, obserwację i regenerację."

msgid "Что означает utrzymać nawyk?"
msgstr "Co oznacza utrzymać nawyk?"

msgid "вводить изменение"
msgstr "wprowadzać zmianę"

msgid "высыпаться"
msgstr "wysypiać się"

msgid "изменить расписание врача"
msgstr "zmienić harmonogram lekarza"

msgid "начать болезнь"
