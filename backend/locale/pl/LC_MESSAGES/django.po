msgid "методологическое ограничение"
msgstr "ograniczenie metodologiczne"

msgid "не путать корреляцию с причинностью"
msgstr "nie mylić korelacji z przyczynowością"

msgid "объяснить расхождение"
msgstr "wyjaśnić rozbieżność"

msgid "оговорить область вывода"
msgstr "zastrzec zakres wniosku"

msgid "смешивающая переменная"
msgstr "zmienna zakłócająca"

msgid "сравнить методологии"
