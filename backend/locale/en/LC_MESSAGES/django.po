msgid "A1 · отдельные слова"
msgstr "A1 single-word"

msgid "A1 — называю себя, людей и предметы простыми фразами"
msgstr "A1 – I call myself, people, and objects simple phrases"

msgid "A1 — отвечаю на простые вопросы, если собеседник помогает"
msgstr "A1 – Answer simple questions if the interviewer helps"

msgid "A1 — передаю простые имена, числа и знакомые слова"
msgstr "A1 — I transmit simple names, numbers, and familiar words"

msgid "A1 — связываем знакомые конструкции"
msgstr "A1 — linking familiar structures"

msgid "A1 — узнаю знакомые слова в очень простой речи и тексте"
msgstr "A1 – I recognize familiar words in very simple speech and text"

msgid "A1–A2 · диалог"
msgstr "A1–A2 dialogue"

msgid "A1–B2 · аудио"
msgstr "A1–B2 • audio"

msgid "A2 — кратко описываю повседневные дела и события"
msgstr "A2 — I briefly describe everyday activities and events"

msgid "A2 — пересказываю главную информацию из короткого сообщения"
msgstr "A2 – I retell the main information from a short message"

msgid "A2 — поддерживаю короткий обмен в привычной ситуации"
msgstr "A2 – Supports a short exchange in the usual situation"

msgid "A2 — понимаю короткие сообщения на повседневные темы"
msgstr "A2 – Understand short messages on everyday topics"

msgid "Ale противопоставляет две оценки фильма."
msgstr "Ale It contrasts the film's two scores."

msgid "Ania ma 12 ___. Выберите форму."
msgstr "Ania ma 12 ___. Choose the form."

msgid "B1 · недельная тренировка ·"
msgstr "B1 • Week-long training"

msgid "B1 · связная речь"
msgstr "B1 • Connected speech"

msgid "B1 — объясняю основные пункты понятного текста или разговора"
msgstr "B1 – Explain the main points of a clear text or conversation"

msgid "B1 — понимаю основную мысль ясной речи и связных текстов"
msgstr "B1 – Understand the basic idea of clear speech and coherent texts"

msgid "B1 — связно рассказываю об опыте, планах и мнениях"
msgstr "B1 — Talk coherently about experiences, plans and opinions"

msgid "B1 — участвую без подготовки в разговоре на знакомую тему"
msgstr "B1 – Unprepared to engage in a conversation on a familiar topic"

msgid "B1–B2 · письмо"
msgstr "B1–B2 letter"

msgid "B1–B2 · ситуации"
msgstr "B1–B2 • Situation"

msgid "B2 · связная речь"
msgstr "B2 • Connected speech"

msgid "B2 — активно обсуждаю идеи и поддерживаю свою позицию"
msgstr "B2 – I actively discuss ideas and support my position"

msgid "B2 — обобщаю разные позиции и поясняю важные детали"
msgstr "B2 – generalize different positions and explain important details"

msgid "B2 — понимаю аргументацию и детали сложных материалов"
msgstr "B2 – Understand the arguments and details of complex materials"

msgid "B2 — ясно и подробно развиваю позицию и аргументы"
msgstr "B2 — I develop my position and arguments clearly and in detail"

msgid "Biuro — офис."
msgstr "Biuro — office."

msgid "Bo вводит причину и соединяет её с главным предложением."
msgstr "Bo introduces the cause and connects it to the main sentence."

msgid "Bo вводит причину отсутствия."
msgstr "Bo introduces the reason for the absence."

msgid "Bo вводит причину эмоционального состояния."
msgstr "Bo Introduces the cause of the emotional state."

msgid "Bo и dlatego że отвечают на вопрос «почему?»: Nie przyszedł, bo był chory."
msgstr "Bo and dlatego że answer the question \"why?\": Nie przyszedł, bo był chory."

msgid "Boli + место в единственном числе: boli mnie głowa, gardło, brzuch."
msgstr "Boli + singular place: boli mnie głowa, gardło, brzuch."

msgid "Boli сочетается с единственным числом, bolą — с множественным."
msgstr "Boli is combined with a single number, bolą with a plural."

msgid "Bolą + множественное число: bolą mnie nogi, oczy, plecy."
msgstr "Bolą + plural: bolą mnie nogi, oczy, plecy."

msgid "Brakować требует родительного: brakuje podpisu."
msgstr "Brakować requires genitive: brakuje podpisu."

msgid "Brzmieć protekcjonalnie — звучать покровительственно, словно говорящий считает себя компетентнее или выше адресата."
msgstr "Brzmieć protekcjonalnie – sound patronizing, as if the speaker considers himself competent or above the addressee."

msgid "Brzuch — единственное число, поэтому boli mnie brzuch."
msgstr "Brzuch is the only number, so boli mnie brzuch."

msgid "Bułka — булочка."
msgstr "Bułka — bun."

msgid "Być — быть"
msgstr "Być — to be"

msgid "Byłem, byłam — что происходило раньше"
msgstr "Byłem, byłam — What happened before?"

msgid "C1 · Гибкость и точность"
msgstr "C1 • Flexibility and accuracy"

msgid "C1 — гибко веду сложное общение в социальных и рабочих ситуациях"
msgstr "C1 – Flexibly communicate in social and work situations"

msgid "C1 — перестраиваю сложную информацию под нужды адресата"
msgstr "C1 – Reconfigure complex information to meet the needs of the addressee"

msgid "C1 — понимаю длинную сложную речь, включая неявный смысл"
msgstr "C1 – understand long, complex speech, including implicit meaning"

msgid "C1 — точно и гибко строю сложное устное или письменное высказывание"
msgstr "C1 – Precisely and flexibly construct a complex oral or written statement"

msgid "C2 · Мастерство смысла"
msgstr "C2 • Mastery of meaning"

msgid "C2 — без труда понимаю почти любую речь и текст"
msgstr "C2 — I can easily understand almost any speech and text"

msgid "C2 — легко управляю тонким, быстрым и неоднозначным взаимодействием"
msgstr "C2 – Easily manages subtle, fast, and ambiguous interactions"

msgid "C2 — создаю свободную, точную и стилистически тонкую речь"
msgstr "C2 – Create free, accurate and stylistically subtle speech"

msgid "C2 — точно синтезирую источники, сохраняя оттенки и регистр"
msgstr "C2 – Precisely synthesize sources, retaining shades and register"

msgid "Chciałbym porozmawiać... звучит профессионально и не категорично."
msgstr "Chciałbym porozmawiać ... sounds professional and uncategorical."

msgid "Chciałbym — вежливая условная форма; dowiedzieć się o требует местного падежа."
msgstr "Chciałbym is a polite conditional form; dowiedzieć się o takes the locative case."

msgid "Chciałbym, mógłby Pan и czy moglibyśmy смягчают просьбу в профессиональной беседе."
msgstr "Chciałbym, mógłby Pan and czy moglibyśmy soften the request in a professional conversation."

msgid "Chciałbym/chciałabym — стандартная вежливая форма просьбы."
msgstr "Chciałbym/chciałabym is the standard polite request form."

msgid "Chciałbym/chciałabym… и Czy może pan/pani… смягчают официальный вопрос."
msgstr "Chciałbym/chciałabym... and Czy może pan/pani... soften the official question."

msgid "Chociaż вводит уступку: трудность не отменяет положительный результат."
msgstr "Chociaż introduces a concession: difficulty does not negate a positive result."

msgid "Chociaż показывает контраст между ожидаемым и реальным."
msgstr "Chociaż shows the contrast between the expected and the real."

msgid "Chociaż соединяет уступку с главным сообщением; uczyć się требует родительного падежа."
msgstr "Chociaż links a concession to the main statement; uczyć się takes the genitive case."

msgid "Choć вводит уступку, а zachowano точно фиксирует сохранённый элемент."
msgstr "Choć introduces a concession, and zachowano precisely fixes the saved element."

msgid "Co lubisz robić? — естественный вопрос «Что ты любишь делать?»."
msgstr "Co lubisz robić? is the natural question, “What do you like to do?”"

msgid "Co lubisz robić…? спрашивает о предпочтениях."
msgstr "Co lubisz robić...? asks about preferences."

msgid "Co robiłeś/robiłaś w weekend? — вопрос о завершённом прошлом."
msgstr "Co robiłeś/robiłaś w weekend? is a question of the completed past."

msgid "Codziennie и przez godzinę указывают на процесс; do piątku и najpierw… potem часто требуют результата."
msgstr "Codziennie and przez godzinę point to a process; do piątku and najpierw... potem often require a result."

msgid "Czasem означает «иногда»."
msgstr "Czasem means \"sometimes.\""

msgid "Cześć — неформальное приветствие; оно также может означать «пока»."
msgstr "Cześć is an informal greeting; it can also mean goodbye."

msgid "Czuć się описывает самочувствие: źle się czuję."
msgstr "Czuć się Describes how you feel: źle się czuję."

msgid "Czy dobrze rozumiem, że… и co dokładnie masz na myśli? помогают проверить смысл до оценки."
msgstr "Czy dobrze rozumiem, że... and co dokładnie masz na myśli? help test the meaning before evaluating."

msgid "Czy moglibyśmy... — нейтральная формальная просьба в условном наклонении."
msgstr "Czy moglibyśmy is a neutral formal request in a conditional inclination."

msgid "Czy może mi pani powiedzieć…? — нейтральная официальная просьба."
msgstr "Czy może mi pani powiedzieć...? is a neutral official request."

msgid "Czy może pani…? — нейтральная официальная просьба."
msgstr "Czy może pani...? is a neutral official request."

msgid "Czy może pan…? сохраняет нейтральный официальный тон."
msgstr "Czy może pan...? maintains a neutral official tone."

msgid "Córka — дочь; syn — сын."
msgstr "Córka — daughter; syn — son."

msgid "Dane wskazują, sugerują или nie pozwalają stwierdzić передают разную силу вывода."
msgstr "Dane wskazują, sugerują or nie pozwalają stwierdzić convey different output strengths."

msgid "Dawkowanie — количество и частота приёма лекарства."
msgstr "Dawkowanie: The amount and frequency of medication."

msgid "Dlaczego задаёт вопрос о причине."
msgstr "Dlaczego Asks about the cause."

msgid "Dlatego начинает следствие: времени не было, поэтому он написал короткое сообщение."
msgstr "Dlatego begins the investigation: there was no time, so he wrote a short message."

msgid "Dlatego показывает результат: Był chory, dlatego został w domu."
msgstr "Dlatego shows the result: Był chory, dlatego został w domu."

msgid "Dlatego соединяет причину с её следствием."
msgstr "Dlatego It connects the cause with its effect."

msgid "Dlatego, wskutek tego и prowadzić do показывают результат."
msgstr "Dlatego, wskutek tego and prowadzić do show results."

msgid "Do + родительный задаёт крайний срок: do piętnastego maja."
msgstr "Do + genitive sets a deadline: do piętnastego maja."

msgid "Dobrze, dziękuję — естественный короткий ответ: «Хорошо, спасибо»."
msgstr "Dobrze, dziękuję is a natural short reply: “Fine, thank you”."

msgid "Dobór słów означает осознанный выбор лексики: одна и та же мысль может звучать нейтрально, официально или разговорно."
msgstr "Dobór słów means conscious choice of vocabulary: the same thought may sound neutral, official or colloquial."

msgid "Dobór słów — выбор слов; выражение подчёркивает, что автор сознательно подбирает лексику под цель и адресата."
msgstr "Dobór słów is the choice of words; the expression emphasizes that the author deliberately chooses the vocabulary for the purpose and addressee."

msgid "Dopiero po выстраивает правильную иерархию этапов."
msgstr "Dopiero po It builds the right hierarchy of stages."

msgid "Dostosować wypowiedź — адаптировать высказывание, то есть изменить лексику, тон или структуру под конкретного адресата."
msgstr "Dostosować wypowiedź — adapt a statement, that is, change the vocabulary, tone or structure for a specific addressee."

msgid "Dotrzymać terminu — выполнить работу в установленный срок."
msgstr "Dotrzymać terminu - to complete the work within the prescribed time."

