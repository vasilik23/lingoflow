{
  "name": "lingoflow-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "expo": "~57.0.24",
    "expo-crypto": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-url-polyfill": "4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "config:check": "node scripts/validate-beta-config.mjs",
    "verify": "npm run config:check && npm run test:build-readiness && npm run test:learning && npm run typecheck",
    "eas": "npx --yes eas-cli@24.14.0",
    "build:check": "node scripts/check-build-readiness.mjs",
    "test:build-readiness": "node --test scripts/build-readiness.test.mjs",
    "test:learning": "node --test scripts/lesson-recovery.test.cjs scripts/session-isolation.test.cjs scripts/lesson-result-api.test.cjs scripts/practice-responses.test.cjs"
  },
  "private": true
}
